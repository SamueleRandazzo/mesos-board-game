<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.text.Font?>

<StackPane prefHeight="720.0" prefWidth="1280.0"
           style="-fx-background-color: radial-gradient(center 50% 50%, radius 70%, #3a1d18 0%, #1a0f0d 100%);"
           xmlns="http://javafx.com/javafx/17"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="it.polimi.ingsw.view.GUI.LobbyController">

    <Region maxWidth="600" maxHeight="600" mouseTransparent="true"
            style="-fx-background-color: radial-gradient(center 50% 50%, radius 50%, rgba(230, 126, 34, 0.12) 0%, transparent 100%);"/>

    <VBox alignment="CENTER" spacing="35.0"
          maxWidth="420.0" maxHeight="380.0"
          style="-fx-background-color: rgba(15, 10, 10, 0.75);
                 -fx-background-radius: 16;
                 -fx-border-radius: 16;
                 -fx-border-color: linear-gradient(to bottom right, rgba(244, 213, 141, 0.4), rgba(0,0,0,0.6));
                 -fx-border-width: 1.5;">

        <effect>
            <DropShadow color="#000000EE" radius="35" spread="0.2" offsetX="0" offsetY="10"/>
        </effect>

        <padding>
            <Insets top="45.0" bottom="45.0" left="35.0" right="35.0"/>
        </padding>

        <VBox alignment="CENTER" spacing="8.0">
            <Label text="GAME LOBBY" textFill="#f4d58d"
                   style="-fx-font-family: 'Impact', 'System Bold'; -fx-letter-spacing: 2px;">
                <font>
                    <Font size="28.0"/>
                </font>
                <effect>
                    <DropShadow color="#000000"/>
                </effect>
            </Label>
            <VBox maxWidth="100.0" minHeight="1.5" style="-fx-background-color: linear-gradient(to right, transparent, #f4d58d, transparent); -fx-opacity: 0.6;"/>
        </VBox>

        <ProgressIndicator prefHeight="80.0" prefWidth="80.0"
                           style="-fx-progress-color: #e67e22; -fx-text-fill: #FFF5E1; -fx-font-weight: bold;">
            <effect>
                <DropShadow color="#d3540066" radius="15" spread="0.2"/>
            </effect>
        </ProgressIndicator>

        <Label fx:id="lobbyStatusLabel" text="Gathering tribe leaders..." textFill="#e0e0e0"
               wrapText="true" alignment="CENTER" textAlignment="CENTER"
               style="-fx-font-size: 15px; -fx-font-style: italic; -fx-opacity: 0.85;"/>
    </VBox>

</StackPane>