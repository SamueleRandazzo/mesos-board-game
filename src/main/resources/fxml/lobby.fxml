<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="400.0" prefWidth="600.0" spacing="30.0"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="it.polimi.ingsw.view.GUI.LobbyController">
    <children>
        <Label text="WAITING LOBBY">
            <font>
                <Font name="System Bold" size="24.0" />
            </font>
        </Label>

        <ProgressIndicator prefHeight="80.0" prefWidth="80.0" />

        <Label fx:id="lobbyStatusLabel" text="Waiting for other players..." textFill="#727272">
            <font>
                <Font size="16.0" />
            </font>
        </Label>
    </children>
</VBox>