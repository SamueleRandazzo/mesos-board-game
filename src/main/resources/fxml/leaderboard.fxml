<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.effect.DropShadow?>

<VBox alignment="CENTER" spacing="25.0" prefWidth="700.0" prefHeight="600.0"
      style="-fx-background-color:
             linear-gradient(from 0% 0% to 100% 0%, repeat, #3e2723 0%, #4e342e 25%, #3e2723 50%, #4e342e 75%, #3e2723 100%),
             linear-gradient(from 0% 0% to 0% 100%, rgba(0,0,0,0.1), rgba(0,0,0,0.4)),
             radial-gradient(center 50% 50%, radius 75%, transparent 30%, rgba(0,0,0,0.6) 100%);"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="it.polimi.ingsw.view.GUI.LeaderboardController">

    <padding>
        <Insets bottom="30.0" left="50.0" right="50.0" top="35.0"/>
    </padding>

    <Label text="FINAL LEADERBOARD"
           style="-fx-text-fill: #f4d58d; -fx-font-size: 32px; -fx-font-weight: 900; -fx-letter-spacing: 3px;">
        <effect>
            <DropShadow blurType="GAUSSIAN" height="15" radius="7" width="15" color="black" />
        </effect>
    </Label>

    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                style="-fx-background: transparent; -fx-background-color: transparent; -fx-padding: 0;">

        <VBox fx:id="leaderboardRowsContainer" spacing="12.0" style="-fx-background-color: transparent;">
            <padding>
                <Insets right="10.0" left="2.0" top="2.0" bottom="2.0"/>
            </padding>
        </VBox>
    </ScrollPane>

    <VBox alignment="CENTER" spacing="6"
          style="-fx-background-color: rgba(0, 0, 0, 0.4); -fx-background-radius: 12; -fx-padding: 14 24 14 24; -fx-border-color: rgba(244, 213, 141, 0.2); -fx-border-radius: 12;">
        <Label fx:id="winnerText" text="The Winner is: Player1!"
               style="-fx-text-fill: #f4d58d; -fx-font-size: 22px; -fx-font-weight: bold; -fx-text-alignment: center;"/>
        <Label fx:id="globalRankText" text="Check how you rank globally"
               style="-fx-text-fill: #ffb3a7; -fx-font-size: 13px; -fx-font-style: italic;"/>
    </VBox>

    <HBox alignment="CENTER">
        <Button fx:id="globalRankButton" text="SHOW GLOBAL RANKINGS" onAction="#handleShowGlobalRankings"
                visible="false" managed="false"
                style="-fx-background-color: linear-gradient(to bottom, #4a3525, #2b1a0d);
                       -fx-text-fill: #f4d58d;
                       -fx-font-weight: bold;
                       -fx-font-size: 13px;
                       -fx-border-color: #f4d58d;
                       -fx-border-width: 1.5;
                       -fx-border-radius: 20;
                       -fx-background-radius: 20;
                       -fx-padding: 12 30;
                       -fx-cursor: hand;
                       -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.5), 8, 0, 0, 3);" />
    </HBox>

</VBox>