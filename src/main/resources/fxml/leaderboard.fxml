<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.paint.Color?>

<VBox alignment="CENTER" spacing="25.0" prefWidth="700.0" prefHeight="550.0"
      style="-fx-background-color: linear-gradient(to bottom right, #790707, #000000);"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="it.polimi.ingsw.view.GUI.LeaderboardController">

    <padding>
        <Insets bottom="30.0" left="40.0" right="40.0" top="30.0"/>
    </padding>

    <Label text="FINAL LEADERBOARD" style="-fx-text-fill: #ecf0f1; -fx-font-size: 32px; -fx-font-weight: bold; -fx-letter-spacing: 2px;">
        <effect>
            <DropShadow blurType="GAUSSIAN" height="10" radius="5" width="10">
                <color><Color opacity="0.5" /></color>
            </DropShadow>
        </effect>
    </Label>

    <TableView fx:id="leaderboardTable" VBox.vgrow="ALWAYS"
               style="-fx-background-radius: 15; -fx-background-color: rgba(255,255,255,0.38); -fx-border-color: #b86208; -fx-border-radius: 15; -fx-padding: 5;">
        <columns>
            <TableColumn fx:id="posColumn" text="POS" prefWidth="70.0" reorderable="false" resizable="false" />
            <TableColumn fx:id="nameColumn" text="PLAYER" prefWidth="230.0" reorderable="false" />
            <TableColumn fx:id="prestigeColumn" text="PRESTIGE" prefWidth="110.0" reorderable="false" />
            <TableColumn fx:id="foodColumn" text="FOOD" prefWidth="110.0" reorderable="false" />
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
    </TableView>

    <VBox alignment="CENTER" spacing="8">
        <Label fx:id="winnerText" style="-fx-text-fill: #f1c40f; -fx-font-size: 20px; -fx-font-weight: bold; -fx-text-alignment: center;"/>
        <Label fx:id="globalRankText" style="-fx-text-fill: #bdc3c7; -fx-font-size: 15px; -fx-font-style: italic;"/>
    </VBox>

    <HBox alignment="CENTER" spacing="20">
        <Button fx:id="globalRankButton" text="Show Global Rankings" onAction="#handleShowGlobalRankings"
                visible="false" managed="false"
                style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 20; -fx-background-radius: 30; -fx-cursor: hand;"/>
    </HBox>

</VBox>