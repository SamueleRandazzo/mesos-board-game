<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="400.0" prefWidth="600.0" spacing="20.0"
      style="-fx-background-color: #f4f4f4;"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="it.polimi.ingsw.view.GUI.SetPlayersController">

    <children>
        <Label text="Game Configuration">
            <font>
                <Font name="System Bold" size="24.0" />
            </font>
        </Label>

        <Label text="You are the first player. Choose how many opponents to wait for:" textFill="#616161" />

        <ComboBox fx:id="numPlayersCombo" prefWidth="150.0" promptText="Select..." />

        <Button mnemonicParsing="false" onAction="#handleConfirm" prefWidth="120.0"
                style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"
                text="CREATE LOBBY" />
    </children>

    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
</VBox>