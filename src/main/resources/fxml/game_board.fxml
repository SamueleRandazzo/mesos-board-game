<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane fx:id="rootStack"
           prefHeight="720.0" prefWidth="1280.0"
           style="-fx-background-color:
                  linear-gradient(from 0% 0% to 100% 0%, repeat, #3e2723 0%, #4e342e 25%, #3e2723 50%, #4e342e 75%, #3e2723 100%),
                  linear-gradient(from 0% 0% to 0% 100%, rgba(0,0,0,0.1), rgba(0,0,0,0.3)),
                  radial-gradient(center 50% 50%, radius 75%, transparent 40%, rgba(0,0,0,0.5) 100%);"
           xmlns="http://javafx.com/javafx/17"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="it.polimi.ingsw.view.GUI.GameBoardController">

    <BorderPane fx:id="mainLayout" style="-fx-background-color: transparent;">
        <top>
            <VBox alignment="CENTER" spacing="2.0"
                  style="-fx-background-color: rgba(43, 43, 43, 0.85); -fx-border-color: #1a1a1a; -fx-border-width: 0 0 2 0;">
                <padding>
                    <Insets bottom="6.0" left="24.0" right="24.0" top="6.0" />
                </padding>

                <Label fx:id="gameNotificationLabel" text="Waiting for the game to start..." textFill="#f4d58d">
                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>
                </Label>
                <Label fx:id="gameLogLabel" text="" textFill="#ffb3a7">
                    <font>
                        <Font name="System Bold Italic" size="12.0" />
                    </font>
                </Label>
            </VBox>
        </top>

        <center>
            <VBox alignment="CENTER" spacing="28.0" BorderPane.alignment="CENTER">
                <padding>
                    <Insets bottom="24.0" left="24.0" right="24.0" top="70.0" />
                </padding>

                <HBox fx:id="upperCardsContainer" alignment="CENTER" spacing="10.0" />

                <HBox alignment="CENTER" spacing="6.0">
                    <StackPane fx:id="firstDeckCardContainer" />
                    <StackPane fx:id="turnOrderContainer" />
                    <HBox fx:id="offerTrackContainer" alignment="CENTER" spacing="6.0" />
                </HBox>

                <HBox fx:id="lowerCardsContainer" alignment="CENTER" spacing="10.0" />

                <HBox alignment="CENTER" spacing="14.0" maxWidth="520.0"
                      style="-fx-background-color: rgba(0,0,0,0.45); -fx-background-radius: 12; -fx-padding: 10 16 10 16;">
                    <VBox alignment="CENTER" spacing="6.0">
                        <ImageView fx:id="artistsIcon" fitWidth="40" fitHeight="40" preserveRatio="true" />
                        <Label fx:id="artistsCount" text="0" textFill="WHITE" style="-fx-font-weight: bold;" />
                    </VBox>
                    <VBox alignment="CENTER" spacing="4.0">
                        <ImageView fx:id="gatherersIcon" fitWidth="40" fitHeight="40" preserveRatio="true" />
                        <Label fx:id="gatherersCount" text="0" textFill="WHITE" style="-fx-font-weight: bold;" />
                    </VBox>
                    <VBox alignment="CENTER" spacing="4.0">
                        <ImageView fx:id="buildersIcon" fitWidth="40" fitHeight="40" preserveRatio="true" />
                        <Label fx:id="buildersCount" text="0" textFill="WHITE" style="-fx-font-weight: bold;" />
                    </VBox>
                    <VBox alignment="CENTER" spacing="4.0">
                        <ImageView fx:id="huntersIcon" fitWidth="40" fitHeight="40" preserveRatio="true" />
                        <Label fx:id="huntersCount" text="0" textFill="WHITE" style="-fx-font-weight: bold;" />
                    </VBox>
                    <VBox alignment="CENTER" spacing="4.0">
                        <ImageView fx:id="inventorsIcon" fitWidth="40" fitHeight="40" preserveRatio="true" />
                        <Label fx:id="inventorsCount" text="0" textFill="WHITE" style="-fx-font-weight: bold;" />
                    </VBox>
                    <VBox alignment="CENTER" spacing="4.0">
                        <ImageView fx:id="shamansIcon" fitWidth="40" fitHeight="40" preserveRatio="true" />
                        <Label fx:id="shamansCount" text="0" textFill="WHITE" style="-fx-font-weight: bold;" />
                    </VBox>
                    <VBox alignment="CENTER" spacing="4.0">
                        <ImageView fx:id="buildingsIcon" fitWidth="40" fitHeight="40" preserveRatio="true" />
                        <Label fx:id="buildingsCount" text="0" textFill="WHITE" style="-fx-font-weight: bold;" />
                    </VBox>
                </HBox>
            </VBox>
        </center>
    </BorderPane>

    <AnchorPane mouseTransparent="true">
        <VBox spacing="8.0" AnchorPane.leftAnchor="20.0" AnchorPane.topAnchor="60.0"
              style="-fx-background-color: rgba(20, 20, 20, 0.5); -fx-background-radius: 10; -fx-padding: 12;">
            <Label text="PLAYERS" textFill="#f4d58d" style="-fx-font-weight: bold; -fx-font-size: 13px;" />
            <VBox fx:id="playersContainer" spacing="8.0" />
        </VBox>

        <HBox alignment="CENTER" spacing="12.0"
              AnchorPane.topAnchor="60.0" AnchorPane.leftAnchor="300.0" AnchorPane.rightAnchor="300.0"
              style="-fx-background-color: rgba(25, 25, 25, 0.65); -fx-background-radius: 12; -fx-padding: 8 16 8 16; -fx-border-color: rgba(244, 213, 141, 0.3); -fx-border-width: 1; -fx-border-radius: 12;">

            <VBox alignment="CENTER" spacing="2.0">
                <Label text="🏆 Prestige" textFill="#f4d58d" style="-fx-font-size: 11px; -fx-font-weight: bold;" />
                <Label fx:id="totalPrestigePointsLabel" text="0" textFill="WHITE" style="-fx-font-size: 15px; -fx-font-weight: bold;" />
            </VBox>

            <Label text="|" textFill="rgba(255,255,255,0.2)" style="-fx-font-size: 16px;"/>

            <VBox alignment="CENTER" spacing="2.0">
                <Label text="🍖 Food" textFill="#ffb3a7" style="-fx-font-size: 11px; -fx-font-weight: bold;" />
                <Label fx:id="currentFoodLabel" text="0" textFill="WHITE" style="-fx-font-size: 15px; -fx-font-weight: bold;" />
            </VBox>

            <Label text="|" textFill="rgba(255,255,255,0.2)" style="-fx-font-size: 16px;"/>

            <VBox alignment="CENTER" spacing="2.0">
                <Label text="🌾 Sust. Disc." textFill="#a2e8dd" style="-fx-font-size: 11px; -fx-font-weight: bold;" />
                <Label fx:id="totalSustenanceDiscountLabel" text="0" textFill="WHITE" style="-fx-font-size: 15px; -fx-font-weight: bold;" />
            </VBox>

            <Label text="|" textFill="rgba(255,255,255,0.2)" style="-fx-font-size: 16px;"/>

            <VBox alignment="CENTER" spacing="2.0">
                <Label text="🏡 Build. Disc." textFill="#8daef4" style="-fx-font-size: 11px; -fx-font-weight: bold;" />
                <Label fx:id="totalBuildingsFoodDiscountLabel" text="0" textFill="WHITE" style="-fx-font-size: 15px; -fx-font-weight: bold;" />
            </VBox>

            <Label text="|" textFill="rgba(255,255,255,0.2)" style="-fx-font-size: 16px;"/>

            <VBox alignment="CENTER" spacing="2.0">
                <Label text="✨ Shaman Stars" textFill="#e2b3ff" style="-fx-font-size: 11px; -fx-font-weight: bold;" />
                <Label fx:id="shamanStarsLabel" text="0" textFill="WHITE" style="-fx-font-size: 15px; -fx-font-weight: bold;" />
            </VBox>

            <Label text="|" textFill="rgba(255,255,255,0.2)" style="-fx-font-size: 16px;"/>

            <VBox alignment="CENTER" spacing="2.0">
                <Label text="📜 Upper Card" textFill="#fcefb4" style="-fx-font-size: 11px; -fx-font-weight: bold;" />
                <Label fx:id="extraCardFromUpperLabel" text="✕" textFill="#ff4d4d" style="-fx-font-size: 16px; -fx-font-weight: bold;" />
            </VBox>

            <Label text="|" textFill="rgba(255,255,255,0.2)" style="-fx-font-size: 16px;"/>

            <VBox alignment="CENTER" spacing="2.0">
                <Label text="➕ Bonus Food" textFill="#ffcbb3" style="-fx-font-size: 11px; -fx-font-weight: bold;" />
                <Label fx:id="extraFoodFromBonusLabel" text="✕" textFill="#ff4d4d" style="-fx-font-size: 16px; -fx-font-weight: bold;" />
            </VBox>
        </HBox>

        <HBox alignment="CENTER" spacing="10.0" AnchorPane.leftAnchor="20.0" AnchorPane.bottomAnchor="20.0"
              style="-fx-background-color: rgba(20, 20, 20, 0.35); -fx-background-radius: 8; -fx-padding: 8;">
            <ImageView fitWidth="82.0" preserveRatio="true" smooth="true">
                <image>
                    <Image url="@../images/PocketRules/Poket Rules Back.png" />
                </image>
            </ImageView>
            <ImageView fitWidth="82.0" preserveRatio="true" smooth="true">
                <image>
                    <Image url="@../images/PocketRules/Poket Rules Front.png" />
                </image>
            </ImageView>
        </HBox>
    </AnchorPane>

    <AnchorPane fx:id="tribeOverlay"
                visible="false" managed="false"
                style="-fx-background-color: rgba(0, 0, 0, 0.7);"> <!-- Sfondo oscurato aumentato per focus -->
        <StackPane AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0"
                   AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0"
                   alignment="CENTER">

            <BorderPane fx:id="tribePanel"
                        prefWidth="950" prefHeight="550"
                        maxWidth="950" maxHeight="550"
                        style="-fx-background-color: rgba(33, 25, 22, 0.95); -fx-border-color: #f4d58d; -fx-border-width: 1.5; -fx-border-radius: 16; -fx-background-radius: 16; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.6), 20, 0, 0, 0);">

                <top>
                    <BorderPane style="-fx-padding: 16 20 10 20; -fx-border-color: rgba(244, 213, 141, 0.2); -fx-border-width: 0 0 1 0;">
                        <left>
                            <Label text="🎪 YOUR TRIBE" textFill="#f4d58d" BorderPane.alignment="CENTER">
                                <font>
                                    <Font name="System Bold" size="18.0" />
                                </font>
                            </Label>
                        </left>
                        <right>
                            <Button fx:id="closeTribeButton" text="✕ Close" BorderPane.alignment="CENTER"
                                    style="-fx-background-color: #d32f2f; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 6 14 6 14; -fx-cursor: hand;"/>
                        </right>
                    </BorderPane>
                </top>

                <center>
                    <ScrollPane fitToWidth="true" fitToHeight="true"
                                vbarPolicy="AS_NEEDED" hbarPolicy="NEVER"
                                style="-fx-background: transparent; -fx-background-color: transparent; -fx-padding: 0;">
                        <content>
                            <VBox alignment="TOP_CENTER" style="-fx-background-color: transparent;">
                                <padding>
                                    <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                                </padding>
                                <HBox fx:id="tribeCardsContainer" alignment="TOP_CENTER" spacing="18.0" style="-fx-background-color: transparent;" />
                            </VBox>
                        </content>
                    </ScrollPane>
                </center>
            </BorderPane>
        </StackPane>
    </AnchorPane>

    <AnchorPane mouseTransparent="true">
        <VBox fx:id="toastContainer"
              alignment="TOP_RIGHT"
              spacing="10.0"
              AnchorPane.topAnchor="20.0"
              AnchorPane.rightAnchor="20.0"
              prefWidth="300.0"
              maxWidth="300.0"
              style="-fx-background-color: transparent;" />
    </AnchorPane>
</StackPane>