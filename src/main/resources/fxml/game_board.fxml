<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.image.Image?>

<StackPane fx:id="rootStack"
           prefHeight="720.0" prefWidth="1280.0"
           style="-fx-background-color: #f2efe6;"
           xmlns="http://javafx.com/javafx/17"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="it.polimi.ingsw.view.GUI.GameBoardController">

    <!-- layout principale -->
    <BorderPane fx:id="mainLayout">
        <top>
            <VBox alignment="CENTER_LEFT" spacing="4.0"
                  style="-fx-background-color: #243447; -fx-border-color: #182534; -fx-border-width: 0 0 2 0;">
                <padding>
                    <Insets bottom="12.0" left="24.0" right="24.0" top="12.0" />
                </padding>
                <Label text="MESOS" textFill="#f4d58d">
                    <font>
                        <Font name="System Bold" size="24.0" />
                    </font>
                </Label>

                <Label fx:id="gameNotificationLabel" text="Waiting for the game to start..." textFill="WHITE">
                    <font>
                        <Font name="System" size="15.0" />
                    </font>
                </Label>
                <Label fx:id="gameLogLabel" text="" textFill="#ffb3a7">
                    <font>
                        <Font name="System Bold Italic" size="13.0" />
                    </font>
                </Label>
            </VBox>
        </top>

        <right>
            <VBox prefWidth="240.0" spacing="14.0"
                  style="-fx-background-color: #ded8c6; -fx-border-color: #c4bba4; -fx-border-width: 0 0 0 1;"
                  BorderPane.alignment="CENTER">
                <padding>
                    <Insets bottom="18.0" left="16.0" right="16.0" top="18.0" />
                </padding>
                <Label text="Players" textFill="#2b2f32">
                    <font>
                        <Font name="System Bold" size="18.0" />
                    </font>
                </Label>
                <VBox fx:id="playersContainer" spacing="8.0" />

                <!-- Pocket Rules (back + front) -->
                <VBox alignment="CENTER" spacing="8.0">
                    <ImageView fitWidth="150" preserveRatio="true" smooth="true">
                        <image>
                            <Image url="@../images/PocketRules/Poket Rules Back.png" />
                        </image>
                    </ImageView>

                    <ImageView fitWidth="150" preserveRatio="true" smooth="true">
                        <image>
                            <Image url="@../images/PocketRules/Poket Rules Front.png" />
                        </image>
                    </ImageView>
                </VBox>
            </VBox>
        </right>

        <center>
            <VBox alignment="CENTER" spacing="18.0" BorderPane.alignment="CENTER">
                <padding>
                    <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
                </padding>

                <!-- Riga carte sopra le mappe -->
                <HBox fx:id="upperCardsContainer"
                      alignment="CENTER"
                      spacing="10.0" />

                <!-- Riga centrale: Tracciato completo -->
                <HBox alignment="CENTER" spacing="6.0">
                    <StackPane fx:id="turnOrderContainer" />
                    <HBox fx:id="offerTrackContainer" alignment="CENTER" spacing="6.0" />
                </HBox>

                <!-- Riga carte sotto le mappe -->
                <HBox fx:id="lowerCardsContainer"
                      alignment="CENTER"
                      spacing="10.0" />

                <!-- Tribe icons (6 slot fissi) -->
                <HBox alignment="CENTER" spacing="14.0">
                    <VBox alignment="CENTER" spacing="6.0">
                        <ImageView fx:id="artistsIcon" fitWidth="40" fitHeight="40" preserveRatio="true" />
                        <Label fx:id="artistsCount" text="0" />
                    </VBox>
                    <VBox alignment="CENTER" spacing="4.0">
                        <ImageView fx:id="gatherersIcon" fitWidth="40" fitHeight="40" preserveRatio="true" />
                        <Label fx:id="gatherersCount" text="0" />
                    </VBox>
                    <VBox alignment="CENTER" spacing="4.0">
                        <ImageView fx:id="buildersIcon" fitWidth="40" fitHeight="40" preserveRatio="true" />
                        <Label fx:id="buildersCount" text="0" />
                    </VBox>
                    <VBox alignment="CENTER" spacing="4.0">
                        <ImageView fx:id="huntersIcon" fitWidth="40" fitHeight="40" preserveRatio="true" />
                        <Label fx:id="huntersCount" text="0" />
                    </VBox>
                    <VBox alignment="CENTER" spacing="4.0">
                        <ImageView fx:id="inventorsIcon" fitWidth="40" fitHeight="40" preserveRatio="true" />
                        <Label fx:id="inventorsCount" text="0" />
                    </VBox>
                    <VBox alignment="CENTER" spacing="4.0">
                        <ImageView fx:id="shamansIcon" fitWidth="40" fitHeight="40" preserveRatio="true" />
                        <Label fx:id="shamansCount" text="0" />
                    </VBox>
                </HBox>
            </VBox>
        </center>
    </BorderPane>

    <!-- overlay tribe (inizialmente chiuso) -->
    <AnchorPane fx:id="tribeOverlay"
                visible="false" managed="false"
                style="-fx-background-color: rgba(0,0,0,0.45);">
        <StackPane AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0"
                   AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0"
                   alignment="CENTER">
            <BorderPane fx:id="tribePanel"
                        prefWidth="900" prefHeight="520"
                        maxWidth="900" maxHeight="520"
                        style="-fx-background-color: #f7f3ea; -fx-border-color: #c4bba4; -fx-border-width: 2; -fx-border-radius: 8; -fx-background-radius: 8;">
                <top>
                    <StackPane style="-fx-padding: 10;">
                        <Button fx:id="closeTribeButton" text="Close" StackPane.alignment="TOP_RIGHT"/>
                    </StackPane>
                </top>
                <center>
                    <ScrollPane fitToWidth="true">
                        <content>
                            <FlowPane fx:id="tribeCardsContainer" hgap="10" vgap="10" prefWrapLength="860"
                                      style="-fx-padding: 12;"/>
                        </content>
                    </ScrollPane>
                </center>
            </BorderPane>
        </StackPane>
    </AnchorPane>

</StackPane>


