<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="mainPane"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="it.polimi.ingsw.view.GUI.LoginController"
            style="-fx-background-color: radial-gradient(center 50% 50%, radius 70%, #3a1d18 0%, #1a0f0d 100%);">

    <StackPane AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0"
               AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">

        <Region maxWidth="600" maxHeight="600" mouseTransparent="true"
                style="-fx-background-color: radial-gradient(center 50% 50%, radius 50%, rgba(230, 126, 34, 0.15) 0%, transparent 100%);"/>

        <VBox alignment="CENTER" spacing="45.0">

            <Label text="MESOS"
                   style="-fx-text-fill: linear-gradient(from 0% 0% to 0% 100%, #FFF5E1 0%, #F4D58D 60%, #B87333 100%);
                          -fx-letter-spacing: 10px;
                          -fx-font-family: 'Papyrus', 'Impact', 'System Bold';
                          -fx-font-weight: bold;">
                <font>
                    <Font size="84.0"/>
                </font>
                <effect>
                    <DropShadow radius="25.0" spread="0.4" color="#d35400">
                        <input>
                            <DropShadow radius="6.0" offsetX="4.0" offsetY="4.0" color="#000000FA"/>
                        </input>
                    </DropShadow>
                </effect>
            </Label>

            <VBox alignment="CENTER" spacing="22.0" maxWidth="350.0" prefWidth="350.0"
                  style="-fx-background-color: rgba(15, 10, 10, 0.75);
                         -fx-background-radius: 16;
                         -fx-border-radius: 16;
                         -fx-border-color: linear-gradient(to bottom right, rgba(244, 213, 141, 0.4), rgba(0,0,0,0.6));
                         -fx-border-width: 1.5;">

                <effect>
                    <DropShadow color="#000000EE" radius="35" spread="0.2" offsetX="0" offsetY="10"/>
                </effect>

                <padding>
                    <Insets top="35" right="35" bottom="35" left="35"/>
                </padding>

                <VBox spacing="8.0" alignment="CENTER_LEFT">
                    <Label text="PLAYER NICKNAME"
                           style="-fx-text-fill: #F4D58D; -fx-font-size: 11px; -fx-font-weight: bold; -fx-letter-spacing: 1px;"/>
                    <TextField fx:id="nicknameField"
                               promptText="Enter your name..."
                               style="-fx-background-color: rgba(0, 0, 0, 0.4);
                                      -fx-text-fill: #FFF5E1;
                                      -fx-prompt-text-fill: rgba(255, 255, 255, 0.35);
                                      -fx-background-radius: 8;
                                      -fx-border-color: rgba(244, 213, 141, 0.25);
                                      -fx-border-radius: 8;
                                      -fx-border-width: 1;
                                      -fx-padding: 12;
                                      -fx-font-weight: bold;"/>
                </VBox>

                <VBox spacing="8.0" alignment="CENTER_LEFT">
                    <Label text="TRIBE EMBLEM COLOR"
                           style="-fx-text-fill: #F4D58D; -fx-font-size: 11px; -fx-font-weight: bold; -fx-letter-spacing: 1px;"/>
                    <ComboBox fx:id="colorComboBox"
                              promptText="Select your color..."
                              maxWidth="Infinity"
                              style="-fx-background-color: rgba(0, 0, 0, 0.4);
                                     -fx-border-color: rgba(244, 213, 141, 0.25);
                                     -fx-border-radius: 8;
                                     -fx-background-radius: 8;
                                     -fx-padding: 6;
                                     -fx-text-fill: #FFF5E1;"/>
                </VBox>

                <Label fx:id="errorLabel" text="" textFill="#ff6b6b" visible="false" wrapText="true"
                       style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 4 0 4 0;"/>

                <Button fx:id="loginButton"
                        text="JOIN GAME"
                        onAction="#handleLogin"
                        maxWidth="Infinity"
                        prefHeight="54.0"
                        style="-fx-background-color: linear-gradient(to bottom, #e67e22, #d35400);
                               -fx-text-fill: #ffffff;
                               -fx-font-weight: bold;
                               -fx-font-size: 16px;
                               -fx-font-family: 'Papyrus', 'Impact', 'System Bold';
                               -fx-background-radius: 10;
                               -fx-cursor: hand;
                               -fx-border-color: #f39c12;
                               -fx-border-radius: 10;
                               -fx-border-width: 1.2;
                               -fx-letter-spacing: 2px;">
                    <VBox.margin>
                        <Insets top="10"/>
                    </VBox.margin>
                    <effect>
                        <DropShadow color="#d3540088" radius="20" spread="0.3" offsetX="0" offsetY="4"/>
                    </effect>
                </Button>
            </VBox>
        </VBox>
    </StackPane>
</AnchorPane>