<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.effect.DropShadow?>

<VBox alignment="CENTER" spacing="25.0" prefWidth="750.0" prefHeight="580.0"
      style="-fx-background-color: linear-gradient(to bottom right, #1a1a1a, #000000, #2c1a04);"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="it.polimi.ingsw.view.GUI.GlobalLeaderboardController">

    <padding>
        <Insets bottom="35.0" left="45.0" right="45.0" top="35.0"/>
    </padding>

    <Label text="🏆 HALL OF FAME 🏆"
           style="-fx-text-fill: #f1c40f; -fx-font-size: 36px; -fx-font-weight: bold; -fx-letter-spacing: 3px;">
        <effect>
            <DropShadow blurType="GAUSSIAN" height="20" width="20" color="rgba(241, 196, 15, 0.6)" />
        </effect>
    </Label>

    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                style="-fx-background: transparent; -fx-background-color: transparent; -fx-padding: 0;">

        <VBox fx:id="globalLeaderboardRowsContainer" spacing="12.0" style="-fx-background-color: transparent;">
            <padding>
                <Insets right="10.0" left="2.0" top="2.0" bottom="2.0"/>
            </padding>
        </VBox>
    </ScrollPane>

</VBox>